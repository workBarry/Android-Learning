{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "web/apps",
  "cli": { "analytics": false },
  "projects": {
    "modern": {
      "projectType": "application",
      "root": "web/apps/modern",
      "sourceRoot": "web/apps/modern",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/modern",
            "index": "web/apps/modern/index.html",
            "browser": "web/apps/modern/main.ts",
            "tsConfig": "tsconfig.modern.json",
            "baseHref": "./",
            "polyfills": [],
            "styles": ["web/shared/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "modern:build:production" },
            "development": { "buildTarget": "modern:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    },
    "legacy": {
      "projectType": "application",
      "root": "web/apps/legacy",
      "sourceRoot": "web/apps/legacy",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:application",
          "options": {
            "outputPath": "dist/legacy",
            "index": "web/apps/legacy/index.html",
            "browser": "web/apps/legacy/main.ts",
            "tsConfig": "tsconfig.legacy.json",
            "baseHref": "./",
            "polyfills": [],
            "styles": ["web/shared/styles.css"]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [{ "type": "initial", "maximumWarning": "700kB", "maximumError": "1MB" }]
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "configurations": {
            "production": { "buildTarget": "legacy:build:production" },
            "development": { "buildTarget": "legacy:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
